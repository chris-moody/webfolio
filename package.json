{
  "name": "folio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "yarn serve:dist",
    "serve:dist": "serve build/client --listen 4173 --no-clipboard",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "size": "node scripts/check-budgets.mjs",
    "lhci": "lhci autorun",
    "check:resume-history": "scripts/check-resume-history.sh",
    "resume:squash": "scripts/resume-squash.sh",
    "prepare": "simple-git-hooks",
    "e2e:dev": "playwright test --config playwright.dev.config.ts",
    "tokens": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "lint:colors": "node scripts/check-color-literals.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/chivo": "^5.1.1",
    "@fontsource/fira-sans": "^5.1.1",
    "@fontsource/rammetto-one": "^5.1.1",
    "@fontsource/roboto": "^5.1.1",
    "@gsap/react": "^2.1.2",
    "@mui/icons-material": "^6.1.10",
    "@mui/material": "^6.3.1",
    "@react-router/node": "7.18.4",
    "@reduxjs/toolkit": "^2.4.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.6",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.4.2",
    "circlepacker": "^2.1.0",
    "classnames": "^2.5.1",
    "color-2-name": "^1.4.4",
    "d3": "^7.9.0",
    "gsap": "^3.15.0",
    "isbot": "^5.2.2",
    "pixi.js": "^8.7.3",
    "react": "^19.3.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.3.0",
    "react-redux": "^9.2.0",
    "react-router": "7.18.4",
    "react-swipeable": "^7.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@emotion/server": "^11",
    "@eslint/js": "^10",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3": "^7.4.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/pixi.js": "^5.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "remark-frontmatter": "^5",
    "remark-mdx-frontmatter": "^6",
    "sass-embedded": "^1.83.4",
    "serve": "^14.2.6",
    "serve-handler": "^6.1.7",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,md,scss,css,html,yml}": "prettier --write"
  },
  "version": "1.2.0"
}
